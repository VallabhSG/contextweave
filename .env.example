# ContextWeave Environment Configuration
# Copy this file to .env and fill in your values

# Required: Groq API key (free tier: 14,400 req/day)
# Get one at: https://console.groq.com/keys
CW_GROQ_API_KEY=your_groq_api_key_here

# Optional: persistent storage — any Postgres with pgvector (e.g. a free Supabase project).
# When set, replaces SQLite + Chroma entirely; the schema is created automatically.
# Use the Supabase Transaction pooler connection string (port 6543).
# CW_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: accept Supabase Auth session tokens (Authorization: Bearer <jwt>).
# Found under Supabase Dashboard -> Settings -> API -> JWT Secret.
# CW_SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: show the sign-in form in the web UI (requires the JWT secret too).
# Both values are public by design — Dashboard -> Settings -> API.
# CW_SUPABASE_URL=https://<project-ref>.supabase.co
# CW_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: pushed daily digest emails. Any SMTP provider works —
# Gmail (smtp.gmail.com + app password), Resend (smtp.resend.com), Mailgun...
# Delivery stays off until CW_SMTP_HOST is set.
# CW_SMTP_HOST=smtp.gmail.com
# CW_SMTP_PORT=587
# CW_SMTP_USERNAME=you@gmail.com
# CW_SMTP_PASSWORD=your_app_password
# CW_DIGEST_FROM_EMAIL=you@gmail.com
# Absolute origin used in unsubscribe links inside the emails:
# CW_PUBLIC_BASE_URL=https://your-host.example.com

# Optional: Override defaults
# CW_CHROMA_PERSIST_DIR=./chroma_data
# CW_SQLITE_DB_PATH=./contextweave.db
# CW_REASONING_MODEL=llama-3.1-8b-instant
# CW_EXTRACTION_MODEL=llama-3.1-8b-instant
# CW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CW_HOST=0.0.0.0
# CW_PORT=8000
# CW_DECAY_HALF_LIFE_DAYS=30.0
# CW_RETRIEVAL_FINAL_K=8
