# ContextWeave Environment Configuration
# Copy this file to .env and fill in your values

# Required: Groq API key (free tier: 14,400 req/day)
# Get one at: https://console.groq.com/keys
CW_GROQ_API_KEY=your_groq_api_key_here

# Optional: Override defaults
# CW_CHROMA_PERSIST_DIR=./chroma_data
# CW_SQLITE_DB_PATH=./contextweave.db
# CW_REASONING_MODEL=llama-3.1-8b-instant
# CW_EXTRACTION_MODEL=llama-3.1-8b-instant
# CW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CW_HOST=0.0.0.0
# CW_PORT=8000
# CW_DECAY_HALF_LIFE_DAYS=30.0
# CW_RETRIEVAL_FINAL_K=8
